{
  "name": "nx-forge-app-esbuild",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/nx-forge-app-esbuild/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/nx-forge-app-esbuild/functions",
        "format": ["cjs"],
        "bundle": true,
        "main": "apps/nx-forge-app-esbuild/src/index.ts",
        "tsConfig": "apps/nx-forge-app-esbuild/tsconfig.app.json",
        "outputFileName": "index.js",
        "assets": ["apps/nx-forge-app-esbuild/src/assets"],
        "generatePackageJson": false,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          },
          "define": {
            "process.env.NODE_ENV": "\"production\""
          }
        },
        "thirdParty": true
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "deploy": {
      "configurations": {
        "development": {
          "manifestTransform": "$ ~> |app|{'licensing': {'enabled': false}}|"
        },
        "staging": {
          "manifestTransform": "$ ~> |app|{'licensing': {'enabled': false}}|"
        },
        "production": {
          "manifestTransform": "$ ~> |app|{'licensing': {'enabled': true}}|"
        }
      }
    },
    "tunnel": {
      "options": {
        "preTunnelTimeout": 10000
      }
    }
  }
}
